# ─── Python Academy — Web API settings ─────────────────────────────────────
# Local development: copy to backend/.env. Production (Railway) sets these as
# service variables instead; never commit a real .env.

# ── Local development only ──
# DEV_AUTH=1 turns on the dev login (any user_id, no Telegram), plain-http
# cookies, the Vite dev origins and the built-in session secret.
# Production keeps the default DEV_AUTH=0: dev login then answers 404.
DEV_AUTH=1

# ── Sessions ──
# Required whenever DEV_AUTH is 0: a long random string. The app refuses to
# start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
# Secure cookies (HTTPS only). Default: on, off only with DEV_AUTH=1.
# COOKIE_SECURE=1

# ── Telegram Login Widget ──
# The real bot token: required to verify Telegram logins. Empty locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=python_academy_tj_bot
TELEGRAM_AUTH_MAX_AGE=86400

# ── Access ──
# Telegram user ids (comma-separated) allowed to open /insights and the mentor
# analytics. Everyone else gets 404.
ADMIN_TELEGRAM_IDS=
# MENTOR_ANALYTICS_OPEN=1 opens analytics to everyone: local debugging only.
# MENTOR_ANALYTICS_OPEN=0

# Browser origins allowed to call the API from another origin (Vite dev server).
# Production serves the site and the API from one origin: leave it unset there.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Public site ──
# Canonical address for canonical links, Open Graph and the sitemap, without a
# trailing slash, e.g. https://academy.example. Unset: taken from the request.
SITE_URL=

# ── Databases ──
# On Railway both files must live on the volume mounted at /data, otherwise a
# redeploy starts with empty databases. Locally leave them commented out:
#   academy.db defaults to the bot folder, mentor.db to backend/data/.
# DB_PATH=/data/academy.db
# MENTOR_DB_PATH=/data/mentor.db

# Path to a live bot checkout (optional; the vendored backend/_bot is used otherwise).
# BOT_DIR=/Users/you/python-academy-bot
