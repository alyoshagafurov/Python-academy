# ─── Python Academy — Web API settings ─────────────────────────────────────
# Local development: copy to backend/.env. Production (Railway) sets these as
# service variables instead; never commit a real .env.
#
# The site has no accounts: no login, no sessions, no per-reader data. Lessons,
# courses, search, checks and the mentor all work without signing in.

# ── Local development only ──
# DEV_MODE=1 allows plain http, the Vite dev origins and a missing SITE_URL.
# Production keeps the default DEV_MODE=0.
DEV_MODE=1

# HTTPS-only headers (HSTS). Default: on, off only with DEV_MODE=1.
# HTTPS_ONLY=1

# ── Public site ──
# Canonical address for canonical links, Open Graph and the sitemap, without a
# trailing slash, e.g. https://academy.example. Required whenever DEV_MODE is 0:
# the app refuses to start without it (public URLs never come from the Host header).
# Locally it may stay empty: the request address is used.
SITE_URL=

# Browser origins allowed to call the API from another origin (Vite dev server).
# Production serves the site and the API from one origin: leave it unset there.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Mentor ──
# The only database the site writes: anonymous telemetry and hint rungs.
# On Railway put it on the volume, otherwise a redeploy starts empty.
# MENTOR_DB_PATH=/data/mentor.db
# Hints and explanations per anonymous reader per hour (default 40).
# MENTOR_RATE_PER_HOUR=40

# Path to a live bot checkout for course content (optional; the vendored
# backend/_bot is used otherwise).
# BOT_DIR=/Users/you/python-academy-bot
